// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusAta {
  PENDENTE
  APROVADA
  REJEITADA
}

enum OrigemAta {
  MANUAL
  PNCP
  // Segunda fonte de rastreamento automático, rodando em paralelo com o
  // PNCP (dadosabertos.compras.gov.br) — decisão de 2026-09-04 de usar as
  // duas fontes em vez de substituir uma pela outra.
  COMPRAS_GOV
  // Atas repassadas pelo CIABC (2026-10-01) — cadastro continua manual
  // (mesmo formulário de MANUAL), só muda a origem pra diferenciar na
  // listagem de onde a ata veio.
  CIABC
}

enum EstagioAdesao {
  MAPEADA
  CONTATO_FORNECEDOR
  APRESENTADA_ORGAO
  OFICIO_EMITIDO
  AGUARDANDO_GERENCIADOR
  ACEITE_FORNECEDOR
  EMPENHADA
  FATURADA
}

model Admin {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  createdAt DateTime @default(now())
  // Marca dados criados pelo seed de demonstração (prisma/seed.ts), pra
  // poder ser apagado seletivamente por prisma/seed-limpar.ts sem tocar
  // em admins reais criados por seed-admin.ts.
  isSeed    Boolean  @default(false)

  @@map("admins")
}

model Fornecedor {
  id          String   @id @default(cuid())
  razaoSocial String
  cnpj        String   @unique
  email       String   @unique
  telefone    String?
  senhaHash   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isSeed      Boolean  @default(false)
  // Gestão de usuários (admin, 2026-09-04) — login recusado quando false,
  // sem apagar nada (atas/adesões/faturamento já existentes continuam
  // intactos, só a conta para de conseguir entrar).
  ativo       Boolean  @default(true)

  // Canal de contato técnico (2026-10-01) — pedido explícito: o vendedor
  // precisa conseguir falar com alguém técnico da empresa que venceu a
  // ata (não só com o município) pra organizar a adesão. Campo livre,
  // sem login próprio — só informação de contato exibida pro vendedor.
  contatoTecnicoNome     String?
  contatoTecnicoTelefone String?
  contatoTecnicoEmail    String?

  atas Ata[]

  @@map("fornecedores")
}

model Orgao {
  id        String   @id @default(cuid())
  nome      String
  cnpj      String   @unique
  uf        String
  municipio String
  esfera    String
  email     String?  @unique
  senhaHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isSeed    Boolean  @default(false)
  // Gestão de usuários (admin, 2026-09-04) — mesma regra do Fornecedor.
  ativo     Boolean  @default(true)

  atasGerenciadas Ata[]    @relation("OrgaoGerenciador")
  adesoes         Adesao[] @relation("OrgaoAderente")

  @@map("orgaos")
}

model Ata {
  id               String    @id @default(cuid())
  numero             String
  objeto             String
  status             StatusAta @default(PENDENTE)
  origem             OrigemAta @default(MANUAL)
  // Tema da ata pra navegação por categoria (Opção A — decidido em
  // 2026-09-04): a ata inteira pertence a um tema, escolhido no cadastro
  // (por quem cadastra hoje; por uma classificação automática amanhã,
  // quando o robô do PNCP ganhar essa inteligência). Nulo pra ata
  // importada que ainda não foi classificada. Vocabulário fixo em
  // src/lib/categorias.ts, igual Item.categoria — não é enum do Prisma
  // de propósito, pra não exigir migração toda vez que um tema for
  // adicionado.
  categoria          String?
  // Chave de deduplicação do rastreador do PNCP (Sprint 7) — nula para
  // atas cadastradas manualmente.
  numeroControlePncp String?   @unique
  dataAssinatura     DateTime
  dataVigenciaFim    DateTime
  fornecedorId       String
  orgaoGerenciadorId String
  // Reivindicação pelo vendedor (2026-10-01): "a partir do momento que
  // ele pegou uma ata ela fica com ele para vender para aqueles
  // municípios" — nulo = disponível no pool pra qualquer vendedor pegar;
  // preenchido = exclusiva desse vendedor daí em diante (não existe
  // "devolver" ainda, decisão de produto em aberto se precisar).
  vendedorId         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  isSeed             Boolean   @default(false)

  fornecedor       Fornecedor      @relation(fields: [fornecedorId], references: [id])
  orgaoGerenciador Orgao           @relation("OrgaoGerenciador", fields: [orgaoGerenciadorId], references: [id])
  vendedor         Vendedor?       @relation(fields: [vendedorId], references: [id])
  itens            Item[]
  documentos       DocumentoAta[]
  interacoesPontoFocal InteracaoPontoFocal[]
  oportunidades        OportunidadeVenda[]
  contrato             ContratoIntermediacao?

  @@unique([numero, orgaoGerenciadorId])
  @@map("atas")
}

// Login próprio do vendedor da Tech 10 (2026-10-01) — painel de fluxo:
// pega uma ata disponível, e o sistema já levanta os municípios
// compatíveis (ver OportunidadeVenda) pra trabalhar num Kanban.
model Vendedor {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  ativo     Boolean  @default(true)
  // Consultor de vendas empresarial interno ou externo (2026-10-01,
  // pedido explícito) — vocabulário fixo em src/lib/vendedores.ts, mesmo
  // racional de categoria/estágio (não enum, evolui sem migração).
  tipo      String   @default("interno")
  createdAt DateTime @default(now())
  isSeed    Boolean  @default(false)

  atas          Ata[]
  oportunidades OportunidadeVenda[]

  @@map("vendedores")
}

// O card do Kanban: um por par (ata, município) — criado automaticamente
// quando o vendedor reivindica a ata (um por município da lista "já
// contrataram" dessa categoria), e também manualmente pelo vendedor pra
// perseguir uma "possível oportunidade" especulativa.
// `estagio` é vocabulário fixo em src/lib/oportunidades.ts (mesmo
// racional de Item.categoria) — não enum do Prisma, pra evoluir sem
// migração.
model OportunidadeVenda {
  id               String    @id @default(cuid())
  ataId            String
  entidadeAlvoId   String
  vendedorId       String
  estagio          String    @default("a_contatar")
  observacoes      String?
  proximoContatoEm DateTime?
  // Controle de recebíveis (2026-10-01, pedido explícito) — preenchidos
  // quando o estágio vira "aderiu": valor que o ente efetivamente aderiu
  // (pode ser menor que o valor total da ata) e o percentual que a
  // Tech 10 recebe sobre o que for liquidado desse valor (ver Liquidacao
  // — o aderido é só o teto, a receita de verdade nasce da liquidação).
  valorAderido        Decimal? @db.Decimal(14, 2)
  percentualComissao  Decimal? @db.Decimal(5, 4)
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt
  isSeed           Boolean   @default(false)

  ata          Ata          @relation(fields: [ataId], references: [id])
  entidadeAlvo EntidadeAlvo @relation(fields: [entidadeAlvoId], references: [id])
  vendedor     Vendedor     @relation(fields: [vendedorId], references: [id])
  liquidacoes  Liquidacao[]

  @@unique([ataId, entidadeAlvoId])
  @@map("oportunidades_venda")
}

// Cada nota fiscal liquidada pelo ente dentro do valor aderido (2026-10-01)
// — um ente pode aderir 50mi e usar só 30mi de fato; a Tech 10 só recebe
// sobre o que foi liquidado, não sobre o valor aderido (que é só o teto).
// Pode ter várias liquidações parciais por oportunidade.
model Liquidacao {
  id               String   @id @default(cuid())
  oportunidadeId   String
  valorLiquidado   Decimal  @db.Decimal(14, 2)
  numeroNotaFiscal String?
  dataLiquidacao   DateTime
  criadoEm         DateTime @default(now())
  isSeed           Boolean  @default(false)

  oportunidade OportunidadeVenda @relation(fields: [oportunidadeId], references: [id])

  @@map("liquidacoes")
}

// Anexo da ata (edital, ofício, ata digitalizada) — decisão de 2026-09-04:
// guardado como bytes direto no Postgres (não um provedor externo tipo
// S3/R2), porque funciona sem nenhuma credencial nova e continua
// funcionando em qualquer ambiente de deploy sério, diferente de disco
// local (que se perde em ambiente serverless). Limite de tamanho é
// aplicado na camada de aplicação (src/app/fornecedor/atas/actions.ts),
// não no schema.
model DocumentoAta {
  id           String   @id @default(cuid())
  ataId        String
  nomeArquivo  String
  tipoMime     String
  tamanhoBytes Int
  conteudo     Bytes
  criadoEm     DateTime @default(now())
  isSeed       Boolean  @default(false)

  ata Ata @relation(fields: [ataId], references: [id])

  @@map("documentos_ata")
}

model Item {
  id                    String  @id @default(cuid())
  ataId                 String
  descricao             String
  categoria             String
  marca                 String?
  unidade               String
  quantidadeRegistrada  Int
  valorUnitario         Decimal @db.Decimal(14, 2)
  isSeed                Boolean @default(false)

  ata     Ata      @relation(fields: [ataId], references: [id])
  adesoes Adesao[]
  saldo   Saldo?

  @@map("itens")
}

// Snapshot materializado do consumo agregado do item, mantido em transação
// junto com cada adesão aceita — evita recalcular a soma de todas as
// adesões a cada checagem da trava do art. 86.
model Saldo {
  id                   String   @id @default(cuid())
  itemId               String   @unique
  quantidadeConsumida  Int      @default(0)
  atualizadoEm         DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id])

  @@map("saldos")
}

model Adesao {
  id                  String        @id @default(cuid())
  itemId              String
  orgaoAderenteId     String
  quantidadeSolicitada Int
  estagio             EstagioAdesao @default(MAPEADA)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  isSeed              Boolean       @default(false)

  item          Item                @relation(fields: [itemId], references: [id])
  orgaoAderente Orgao               @relation("OrgaoAderente", fields: [orgaoAderenteId], references: [id])
  historico     AdesaoHistorico[]
  faturamento   Faturamento?

  @@map("adesoes")
}

// Trilha de auditoria exigida pelo plano: quem mudou o estágio e quando.
model AdesaoHistorico {
  id              String        @id @default(cuid())
  adesaoId        String
  estagioAnterior EstagioAdesao?
  estagioNovo     EstagioAdesao
  alteradoPor     String
  alteradoEm      DateTime      @default(now())

  adesao Adesao @relation(fields: [adesaoId], references: [id])

  @@map("adesoes_historico")
}

// Gerada automaticamente quando a adesão chega em EMPENHADA (Sprint 8) —
// é o "contas a receber" da Tech 10.
//
// Cobrada exclusivamente do fornecedor (Ata.fornecedor) — o órgão público
// nunca é parte nem paga nada nesta cobrança. É um contrato civil privado
// entre a Tech 10 e o fornecedor, separado do instrumento de licitação;
// nenhuma cláusula da ata ou do edital condiciona a adesão a este valor.
//
// O repasse à empresa desenvolvedora é um acerto privado entre a Tech 10 e
// a desenvolvedora, fora da plataforma — não é calculado nem registrado
// aqui. Este valor é sempre o total devido à Tech 10.
model Faturamento {
  id                     String    @id @default(cuid())
  adesaoId               String    @unique
  valorContrato          Decimal   @db.Decimal(14, 2)
  percentualTaxa         Decimal   @db.Decimal(5, 4)
  valorTaxaIntermediacao Decimal   @db.Decimal(14, 2)
  pago                   Boolean   @default(false)
  pagoEm                 DateTime?
  criadoEm               DateTime  @default(now())

  adesao Adesao @relation(fields: [adesaoId], references: [id])

  @@map("faturamentos")
}

// Mapa do núcleo de atas (2026-09-05) — cadastro de contato por esfera/UF/
// município (prefeito, governador ou intermediário) com as particularidades
// da relação, pra apoiar a decisão de quem procurar antes de oferecer uma
// ata. Acesso restrito ao admin (nunca exposto a fornecedor/órgão) — é
// justamente o "banco de dados secreto" descrito nas notas de voz que
// originaram o mapa; controle de acesso mais fino (quem no time interno
// pode ver o quê) fica para quando existir mais de um perfil de admin.
// Reorganizado em 2026-09-05 — o trabalho de venda é humano ("de
// formiguinha", não automatizado), então o CRM precisa refletir a
// realidade real: uma prefeitura/secretaria/ministério (a "entidade
// alvo") tem VÁRIOS contatos (prefeito, secretário de cada pasta,
// intermediário), não um contato só. Antes disso, PontoFocal misturava
// os dois níveis numa linha só (esfera/uf/município junto com o
// contato) — separado agora em duas tabelas.
model EntidadeAlvo {
  id        String   @id @default(cuid())
  nome      String
  // Tipo livre (não enum, mesmo racional de src/lib/categorias.ts):
  // "municipal" | "estadual" | "federal" | "ministerio" | "secretaria" —
  // a separação ministerial/secretaria/municipal/estadual/federal pedida
  // nas notas de voz. Esfera (quando existe) usa o vocabulário de
  // src/lib/esferas.ts.
  tipo      String
  esfera    String?
  uf        String?
  municipio String?
  endereco  String?
  // Código do município no IBGE — só preenchido pra entidade tipo
  // "municipal" vinda do levantamento de dados (2026-09-05, ver
  // prisma/seed-municipios-alvo.ts). Chave de upsert segura: permite
  // rodar o levantamento de novo (lote 2, lote 3...) sem duplicar
  // município já cadastrado.
  codigoIbgeMunicipio String? @unique
  // CNPJ da prefeitura — enriquecido automaticamente a partir do SICONFI
  // (Tesouro Nacional), cruzando por `codigoIbgeMunicipio`. É a chave
  // usada pra puxar o histórico de contratos no PNCP (raio-X de
  // consumo, 2026-09-25) — sem ela não dá pra saber o que o município já
  // contratou antes.
  cnpj      String?  @unique
  // Quando o raio-X de consumo rodou pela última vez pra esta entidade —
  // marcado mesmo quando o resultado foi "nenhuma categoria
  // identificada" (sem isso, o script de lote reprocessava esses
  // municípios pra sempre, já que zero categoria = zero linha em
  // HistoricoConsumoCategoria = "parece que nunca rodou").
  raioXAtualizadoEm DateTime?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isSeed    Boolean  @default(false)

  contatos       PontoFocal[]
  historicoConsumo HistoricoConsumoCategoria[]
  oportunidades    OportunidadeVenda[]

  @@map("entidades_alvo")
}

model PontoFocal {
  id               String   @id @default(cuid())
  entidadeAlvoId   String
  cargo            String
  // Pasta/departamento específico deste contato dentro da entidade (ex.:
  // "Secretaria de Saúde", "Gabinete do Prefeito") — é o que permite
  // guardar "contatos de todas as áreas" de um mesmo município.
  area             String?
  nomeContato      String
  telefone         String?
  email            String?
  particularidades String?
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isSeed           Boolean  @default(false)

  entidadeAlvo EntidadeAlvo          @relation(fields: [entidadeAlvoId], references: [id])
  interacoes   InteracaoPontoFocal[]

  @@map("pontos_focais")
}

// Histórico de match: qual ata foi oferecida a este ponto focal e o que
// resultou disso — é o que permite refinar capilaridade com o tempo, em
// vez de repetir a mesma oferta pra quem já recusou.
model InteracaoPontoFocal {
  id           String   @id @default(cuid())
  pontoFocalId String
  ataId        String?
  resultado    String
  observacao   String?
  criadoEm     DateTime @default(now())
  isSeed       Boolean  @default(false)

  pontoFocal PontoFocal @relation(fields: [pontoFocalId], references: [id])
  ata        Ata?       @relation(fields: [ataId], references: [id])

  @@map("interacoes_ponto_focal")
}

// "Os 30 parceiros" das notas de voz — quem revende/comercializa atas junto
// com a Tech 10. categoriasInteresse usa os mesmos slugs de
// src/lib/categorias.ts; ufsInteresse são siglas de UF. Nenhum dos dois é
// enum do Prisma, mesmo racional de Item.categoria — vocabulário evolui
// sem migração.
model Parceiro {
  id                  String   @id @default(cuid())
  nome                String
  contato             String
  categoriasInteresse String[]
  ufsInteresse        String[]
  ativo               Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  isSeed              Boolean  @default(false)

  @@map("parceiros")
}

// "Raio-X de consumo" (2026-09-25) — pedido explícito do usuário: não
// basta saber quem são os responsáveis do município, precisa saber o
// que e há quanto tempo eles compram, pra vender a ata certa na hora
// certa ("quanto tempo tem que eles não fazem um pregão de contratação
// de gráfica, de equipamento hospitalar, de kit escolar..."). Uma linha
// por (entidade, categoria) — snapshot materializado, recalculado sob
// demanda (botão na tela da entidade), não em tempo real, porque a
// fonte é o histórico de contratos do PNCP (`/v1/contratos`), que exige
// uma chamada por ano de janela (limite de 365 dias por consulta) — caro
// demais pra fazer isso pra 1000+ municípios de uma vez, só faz sentido
// por demanda, um município de cada vez.
model HistoricoConsumoCategoria {
  id               String   @id @default(cuid())
  entidadeAlvoId   String
  categoria        String
  ultimaContratacao DateTime
  valorUltimaContratacao Decimal @db.Decimal(14, 2)
  quantidadeContratosNaJanela Int
  objetoUltimaContratacao String
  atualizadoEm     DateTime @updatedAt

  entidadeAlvo EntidadeAlvo @relation(fields: [entidadeAlvoId], references: [id])

  @@unique([entidadeAlvoId, categoria])
  @@map("historico_consumo_categoria")
}

// Contrato de intermediação com o fornecedor da ata (2026-10-04, SCP cl. 4
// e Projeto RNA §2): nenhuma abordagem a município sem ele. O percentual
// (3%–15%) é pactuado pelo admin com o fornecedor — não é digitado pelo
// vendedor; a oportunidade só copia esse valor quando vira "aderiu".
model ContratoIntermediacao {
  id                 String    @id @default(cuid())
  ataId              String    @unique
  percentualComissao Decimal   @db.Decimal(5, 4)
  dataAssinatura     DateTime
  vigenciaFim        DateTime?
  observacoes        String?
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt

  ata Ata @relation(fields: [ataId], references: [id])

  @@map("contratos_intermediacao")
}
