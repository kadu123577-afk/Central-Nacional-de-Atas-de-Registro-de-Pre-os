# Copie para .env e preencha com valores reais. Nunca commitar o .env real.

# String de conexão do Postgres (Supabase, em produção).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/central_atas?schema=public"

# String aleatória longa usada para assinar o cookie de sessão do fornecedor.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
