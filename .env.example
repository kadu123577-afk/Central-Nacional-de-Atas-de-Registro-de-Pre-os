# Copie para .env e preencha com valores reais. Nunca commitar o .env real.

# String de conexão do Postgres. O valor abaixo já é o padrão que o
# instalar.bat/README pedem pra usar em desenvolvimento local (usuário
# "postgres", senha "localdev", banco "central_atas"). Em produção, troque
# pela string de conexão do Supabase.
DATABASE_URL="postgresql://postgres:localdev@localhost:5432/central_atas?schema=public"

# String aleatória longa (mín. 32 caracteres; use 64+) usada para assinar os
# cookies de sessão. Em produção, use um valor diferente do de desenvolvimento.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Cifra o segredo do 2FA dos admins no banco (AES-256-GCM). Defina em produção
# e NÃO troque depois (os admins teriam de recadastrar o 2FA). Se ficar vazio,
# usa o SESSION_SECRET. Gere do mesmo jeito que o SESSION_SECRET.
TOTP_ENCRYPTION_KEY=""

# Protege /api/rastreador-pncp e /api/rastreador-compras-gov. OBRIGATÓRIO em
# produção: sem ele as rotas recusam toda chamada (401). Em desenvolvimento,
# sem ele, ficam abertas.
# A Vercel envia esse valor automaticamente no header Authorization das
# execuções do cron (ver vercel.json) quando esta env var está configurada
# no projeto.
CRON_SECRET=""

# Token de acesso à API de órgãos do PNCP (itens da compra + fornecedor
# vencedor), usado para enriquecer as atas importadas com quantidade, valor
# e fornecedor de verdade. Sem isso, a ata ainda é importada, mas sem itens.
PNCP_ACCESS_TOKEN=""

# --- Site público (vitrine) -------------------------------------------------
# Endereço público do site (metadados, sitemap). Padrão: https://atas.arcacapital.com.br
NEXT_PUBLIC_SITE_URL=""
# WhatsApp oficial, só dígitos com DDI (ex.: 5562900000000). Vazio = os botões de
# contato abrem o e-mail.
WHATSAPP_OFICIAL=""
# Liga a indexação no Google (robots/sitemap). Deixe desligado até haver dados
# reais publicados: com "true" as atas aprovadas entram no sitemap.
INDEXAR_SITE=""
# "true" mostra a faixa de demonstração e inclui os dados de demonstração no
# catálogo público. NUNCA ligue em produção.
AMBIENTE_DEMONSTRACAO=""

# Percentual da taxa de intermediação cobrada do fornecedor sobre o valor
# do contrato (ex.: 0.05 = 5%, confirmado pela Tech 10). Sem isso, usa o
# padrão de 5%.
TAXA_INTERMEDIACAO_PERCENTUAL="0.05"
